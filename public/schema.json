{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Storefront Schema",
  "type": "object",
  "required": ["store", "categories", "products"],
  "properties": {
    "store": {
      "type": "object",
      "required": ["id", "slug", "name", "whatsapp", "currency", "locale", "theme"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "logoText": { "type": "string" },
        "logoUrl": { "type": "string" },
        "headline": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "whatsapp": { "type": "string" },
        "currency": { "type": "string" },
        "locale": { "type": "string" },
        "theme": {
          "type": "object",
          "required": ["primaryColor", "accentColor", "backgroundColor"],
          "properties": {
            "primaryColor": { "type": "string" },
            "accentColor": { "type": "string" },
            "backgroundColor": { "type": "string" }
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "name", "order", "active"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "order": { "type": "number" },
          "active": { "type": "boolean" }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "name", "description", "price", "currency", "imageUrl", "categoryId", "active"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "compareAtPrice": { "type": "number" },
          "currency": { "type": "string" },
          "imageUrl": { "type": "string" },
          "gallery": {
            "type": "array",
            "items": { "type": "string" }
          },
          "categoryId": { "type": "string" },
          "sku": { "type": "string" },
          "stock": { "type": "number" },
          "active": { "type": "boolean" },
          "featured": { "type": "boolean" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "order": { "type": "number" }
        }
      }
    }
  }
}
